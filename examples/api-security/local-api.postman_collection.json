{
  "info": {
    "name": "Kali Fieldbook - local API security (fixed mode)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Synthetic loopback fixture only. Run requests in order against fixed mode. Tokens remain runtime variables and are not included in this export."
  },
  "item": [
    {
      "name": "01 Anonymous denied",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://127.0.0.1:8901/api/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "alice login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://127.0.0.1:8901/login",
        "body": {
          "mode": "raw",
          "raw": "{\"user\": \"alice\", \"password\": \"alice-lab\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status\", function () { pm.response.to.have.status(200); });",
              "pm.variables.set(\"alice_pending\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
